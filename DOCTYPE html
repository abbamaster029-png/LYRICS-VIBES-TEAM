<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>LYRICS VIBES TEAM | Member Profile</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

<style>

/* ================================
   RESET
================================ */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}


/* ================================
   BODY
================================ */

body{
    min-height:100vh;

    background:
        radial-gradient(
            circle at 50% -20%,
            #1d477d 0%,
            #0d2b55 28%,
            #061a37 60%,
            #020a18 100%
        );

    color:#ffffff;

    font-family:'Inter',sans-serif;

    padding:14px 10px 24px;
}


/* ================================
   PAGE
================================ */

.page{
    width:100%;
    max-width:380px;
    margin:0 auto;
}


/* ================================
   HEADER
================================ */

.header{
    text-align:center;
    margin-bottom:13px;
}

.logo{
    width:30px;
    height:30px;

    margin:0 auto 6px;

    display:flex;
    align-items:center;
    justify-content:center;

    border:1px solid #d9ad32;
    border-radius:50%;

    background:#061a36;

    color:#e4b83f;

    font-family:'Playfair Display',serif;

    font-size:10px;
    font-weight:700;

    box-shadow:
        0 0 15px rgba(217,173,50,.12);
}

.team-name{
    color:#e4b83f;

    font-family:'Playfair Display',serif;

    font-size:18px;

    font-weight:700;

    line-height:1.15;

    letter-spacing:.8px;
}

.subtitle{
    margin-top:4px;

    color:#9caabd;

    font-size:6.5px;

    font-weight:600;

    letter-spacing:1.9px;

    text-transform:uppercase;
}

.header-line{
    width:35px;
    height:1px;

    margin:7px auto 0;

    background:#d9ad32;

    box-shadow:
        0 0 7px rgba(217,173,50,.45);
}


/* ================================
   MAIN CARD
================================ */

.card{
    position:relative;

    width:100%;

    overflow:hidden;

    background:
        linear-gradient(
            145deg,
            rgba(10,39,77,.98),
            rgba(3,16,35,.99)
        );

    border:1px solid rgba(217,173,50,.55);

    border-radius:15px;

    box-shadow:
        0 15px 35px rgba(0,0,0,.30);
}

.card::before{
    content:"";

    position:absolute;

    top:0;
    left:15%;
    right:15%;

    height:1px;

    background:#e2b83f;

    opacity:.8;
}


/* ================================
   PROFILE
================================ */

.profile{
    text-align:center;

    padding:17px 13px 14px;
}


/* Avatar */

.avatar{
    width:52px;
    height:52px;

    margin:0 auto 8px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:50%;

    border:1px solid #d9ad32;

    background:
        radial-gradient(
            circle,
            #194579,
            #061832
        );

    color:#e4b83f;

    font-family:'Playfair Display',serif;

    font-size:23px;

    font-weight:700;

    box-shadow:
        0 0 0 3px rgba(217,173,50,.04);
}


/* Verified */

.verified{
    display:flex;

    align-items:center;
    justify-content:center;

    gap:4px;

    margin-bottom:5px;

    color:#8494aa;

    font-size:6.5px;

    font-weight:600;

    letter-spacing:1px;

    text-transform:uppercase;
}

.verified-dot{
    width:4px;
    height:4px;

    border-radius:50%;

    background:#d9ad32;

    box-shadow:
        0 0 5px rgba(217,173,50,.6);
}


/* Name */

.member-name{
    color:#ffffff;

    font-family:'Playfair Display',serif;

    font-size:18px;

    font-weight:600;

    line-height:1.25;

    letter-spacing:.1px;

    margin-bottom:7px;
}


/* Admin */

.position{
    display:inline-block;

    padding:4px 15px;

    border-radius:20px;

    background:
        linear-gradient(
            135deg,
            #e9c454,
            #c79620
        );

    color:#061832;

    font-size:7px;

    font-weight:700;

    letter-spacing:1px;

    box-shadow:
        0 4px 10px rgba(217,173,50,.10);
}


/* ================================
   MEMBER META
================================ */

.member-meta{
    display:grid;

    grid-template-columns:1fr 1fr;

    border-top:1px solid rgba(217,173,50,.14);

    border-bottom:1px solid rgba(217,173,50,.14);
}

.meta{
    text-align:center;

    padding:9px 5px;
}

.meta:first-child{
    border-right:1px solid rgba(217,173,50,.14);
}

.meta-label{
    display:block;

    color:#718199;

    font-size:6px;

    font-weight:600;

    letter-spacing:.8px;

    text-transform:uppercase;

    margin-bottom:3px;
}

.meta-value{
    color:#dfb53e;

    font-size:8.5px;

    font-weight:600;

    letter-spacing:.4px;
}


/* ================================
   PRIVATE SECTION
================================ */

.private{
    padding:13px;
}


/* Private heading */

.private-heading{
    text-align:center;

    margin-bottom:9px;
}

.private-icon{
    width:28px;
    height:28px;

    margin:0 auto 5px;

    display:flex;
    align-items:center;
    justify-content:center;

    border:1px solid rgba(217,173,50,.35);

    border-radius:50%;

    background:rgba(217,173,50,.05);

    font-size:11px;
}

.private-title{
    color:#e1b63e;

    font-family:'Playfair Display',serif;

    font-size:12px;

    font-weight:600;

    line-height:1.2;
}

.private-subtitle{
    color:#718096;

    font-size:6.5px;

    margin-top:2px;
}


/* ================================
   PASSWORD BOX
================================ */

.password-box{
    padding:10px;

    border:1px solid rgba(217,173,50,.16);

    border-radius:9px;

    background:rgba(0,7,18,.25);

    text-align:center;
}

.password-label{
    display:block;

    color:#7f8da2;

    font-size:6px;

    font-weight:600;

    letter-spacing:.8px;

    text-transform:uppercase;

    margin-bottom:4px;
}

input{
    width:100%;

    height:35px;

    border:1px solid rgba(217,173,50,.28);

    border-radius:7px;

    background:#061832;

    color:#ffffff;

    padding:0 10px;

    outline:none;

    text-align:center;

    font-family:'Inter',sans-serif;

    font-size:9px;
}

input::placeholder{
    color:#68778d;
}

input:focus{
    border-color:#d9ad32;

    box-shadow:
        0 0 0 2px rgba(217,173,50,.05);
}


/* Button */

button{
    width:100%;

    height:35px;

    margin-top:6px;

    border:none;

    border-radius:7px;

    background:
        linear-gradient(
            135deg,
            #edc653,
            #c79620
        );

    color:#061832;

    font-family:'Inter',sans-serif;

    font-size:7px;

    font-weight:700;

    letter-spacing:.7px;

    cursor:pointer;

    transition:.2s ease;
}

button:hover{
    filter:brightness(1.06);
}

button:active{
    transform:scale(.98);
}


/* ================================
   ERROR
================================ */

.error{
    display:none;

    margin-top:6px;

    color:#ff8585;

    text-align:center;

    font-size:7px;
}


/* ================================
   PRIVATE INFORMATION
================================ */

.private-info{
    display:none;

    margin-top:10px;

    padding-top:9px;

    border-top:1px solid rgba(217,173,50,.16);

    text-align:center;
}

.info-item{
    padding:7px 2px;

    border-bottom:1px solid rgba(255,255,255,.05);

    line-height:1.45;
}

.info-item:last-child{
    border-bottom:none;
}

.info-item strong{
    display:block;

    color:#dcb33e;

    font-size:6.5px;

    font-weight:700;

    letter-spacing:.7px;

    text-transform:uppercase;

    margin-bottom:2px;
}

.info-item span{
    color:#d9e1ed;

    font-size:8px;
}


/* ================================
   FOOTER
================================ */

.footer{
    text-align:center;

    margin-top:10px;

    color:#718096;

    font-size:6.5px;

    letter-spacing:1.5px;

    text-transform:uppercase;
}

.footer strong{
    color:#c39d34;
}


/* ================================
   VERY SMALL PHONES
================================ */

@media(max-width:340px){

    body{
        padding:11px 8px 20px;
    }

    .page{
        max-width:360px;
    }

    .team-name{
        font-size:17px;
    }

    .profile{
        padding:15px 11px 12px;
    }

    .avatar{
        width:48px;
        height:48px;
        font-size:21px;
    }

    .member-name{
        font-size:16px;
    }

    .private{
        padding:11px;
    }
}

</style>
</head>


